<?php

/**
 * @file
 * Provides Ollama integration for the OpenAI module.
 *
 * Ollama allows you to run LLMs locally on your own hardware.
 * This module integrates Ollama's OpenAI-compatible API with the OpenAI module.
 *
 * @see https://docs.ollama.com/api/openai-compatibility
 */

/**
 * Implements hook_autoload_info().
 */
function openai_ollama_autoload_info() {
  return [
    'OllamaAdapter' => 'includes/OllamaAdapter.php',
  ];
}

/**
 * Implements hook_openai_provider_info().
 */
function openai_ollama_openai_provider_info() {
  return [
    'ollama' => [
      'label' => t('Ollama'),
      'description' => t('Run AI models locally on your own hardware. Supports Llama, Mistral, Phi, and many more open models. No API key required.'),
      'class' => 'OllamaAdapter',
      'website' => 'https://ollama.ai/',
      'models_url' => 'https://ollama.ai/library',
    ],
  ];
}

/**
 * Implements hook_config_info().
 */
function openai_ollama_config_info() {
  return [
    'openai_ollama.settings' => [
      'label' => t('Ollama Settings'),
      'group' => t('Configuration'),
    ],
  ];
}

/**
 * Implements hook_openai_provider_settings_alter().
 *
 * Adds Ollama-specific settings to the main OpenAI settings form.
 */
function openai_ollama_openai_provider_settings_alter(&$settings, $context) {
  // Only add settings if Ollama is the selected provider
  if ($context['provider'] !== 'ollama') {
    return;
  }

  // Prefer the central openai.settings providers mapping, fall back to module config.
  $providers_root = config_get('openai.settings', 'providers') ?: [];
  // Use only the provider-specific key 'ollama_base_url'. Do not read/write
  // the generic 'base_url'. Fall back to a reasonable default if the provider
  // setting is not present. (Do NOT read from openai_ollama.settings.)
  $default_base_url = !empty($providers_root['ollama']['ollama_base_url']) ? $providers_root['ollama']['ollama_base_url'] : 'http://localhost:11434';

  $settings['ollama_base_url'] = [
    '#type' => 'textfield',
    '#title' => t('Ollama Server URL'),
    '#default_value' => $default_base_url,
    '#description' => t('The base URL of your Ollama server. Default is http://localhost:11434 for local installations.'),
    '#required' => FALSE,
    '#weight' => 0,
  ];

  $settings['ollama_help'] = [
    '#type' => 'markup',
    '#markup' => '<div class="description">' .
      t('<h4>Getting Started with Ollama</h4>
      <ol>
        <li>Install Ollama from <a href="https://ollama.ai" target="_blank">ollama.ai</a></li>
        <li>Pull a model: <code>ollama pull llama3.2</code></li>
        <li>Ollama automatically starts an API server on port 11434</li>
        <li>No API key is needed - Ollama runs locally</li>
      </ol>
      <p><strong>Popular models:</strong> llama3.2, mistral, phi3, codellama, gemma2</p>
      <p><a href="https://ollama.ai/library" target="_blank">Browse all models</a></p>') .
      '</div>',
    '#weight' => 10,
  ];

  // If Ollama is enabled in central config and an ollama_base_url is configured,
  // attempt to fetch available models and show them in the settings UI.
  $enabled = !empty($providers_root['ollama']['enabled']);
  $base_url = !empty($providers_root['ollama']['ollama_base_url']) ? $providers_root['ollama']['ollama_base_url'] : $default_base_url;

  if (!empty($enabled) && !empty($base_url)) {
    try {
      // First try the pluggable provider adapter if available.
      $models = [];
      $adapter = NULL;
      if (function_exists('openai_get_api')) {
        $adapter = openai_get_api('ollama');
      }

      if (!empty($adapter) && method_exists($adapter, 'getModels')) {
        try {
          $provider_models = $adapter->getModels();
        }
        catch (Exception $e) {
          watchdog('openai_ollama', 'Ollama adapter getModels() failed: @msg', ['@msg' => $e->getMessage()], WATCHDOG_WARNING);
          $provider_models = [];
        }

        if (!empty($provider_models) && is_array($provider_models)) {
          foreach ($provider_models as $k => $v) {
            if (is_int($k)) {
              if (is_array($v)) {
                $models[] = [
                  'id' => isset($v['id']) ? (string) $v['id'] : (isset($v['name']) ? (string) $v['name'] : json_encode($v)),
                  'display_name' => isset($v['display_name']) ? $v['display_name'] : (isset($v['id']) ? $v['id'] : NULL),
                  'owned_by' => isset($v['owned_by']) ? $v['owned_by'] : NULL,
                ];
              }
              else {
                $models[] = ['id' => (string) $v];
              }
            }
            else {
              if (is_array($v)) {
                $models[] = [
                  'id' => (string) $k,
                  'display_name' => isset($v['display_name']) ? $v['display_name'] : (isset($v['id']) ? $v['id'] : json_encode($v)),
                  'owned_by' => isset($v['owned_by']) ? $v['owned_by'] : NULL,
                ];
              }
              else {
                $models[] = ['id' => (string) $k, 'display_name' => (string) $v];
              }
            }
          }
        }
      }

      // If adapter didn't yield models, fall back to the helper that calls
      // the Ollama API directly.
      if (empty($models)) {
        $raw = openai_ollama_get_models($base_url);
        if (!empty($raw) && is_array($raw)) {
          foreach ($raw as $m) {
            if (is_string($m)) {
              $models[] = ['id' => $m];
            }
            elseif (is_array($m)) {
              $models[] = [
                'id' => isset($m['id']) ? (string) $m['id'] : (isset($m['name']) ? (string) $m['name'] : json_encode($m)),
                'display_name' => isset($m['display_name']) ? $m['display_name'] : (isset($m['id']) ? $m['id'] : NULL),
                'owned_by' => isset($m['owned_by']) ? $m['owned_by'] : NULL,
              ];
            }
          }
        }
      }

      // Build list items for markup
      $items = [];
      foreach ($models as $m) {
        $id = isset($m['id']) ? $m['id'] : (isset($m['name']) ? $m['name'] : json_encode($m));
        $label = isset($m['display_name']) && $m['display_name'] ? $m['display_name'] : $id;
        if (!empty($m['owned_by'])) {
          $label .= ' (' . $m['owned_by'] . ')';
        }
        $items[] = '<li>' . check_plain($label) . '</li>';
      }

      // Place into form if we have any models, otherwise show a friendly message.
      if (!empty($items)) {
        if (isset($context['form']['providers'])) {
          $provider_label = function_exists('openai_get_provider_label') ? openai_get_provider_label($context['provider']) : ucfirst($context['provider']);
          $context['form']['providers'][$context['provider'] . '_settings'][$context['provider'] . '_models'] = [
            '#type' => 'markup',
            '#markup' => '<details class="provider-models"><summary><strong>' . check_plain($provider_label) . ' — ' . count($items) . ' models</strong></summary>'
              . '<div style="max-height:300px; overflow:auto; padding-left:1.2em; margin-top:0.5em;"><ul style="margin:0; padding-left:1.2em;">'
              . implode('', $items) . '</ul></div></details>',
            '#weight' => 100,
          ];
        }
      }
      else {
        if (isset($context['form']['providers'])) {
          $context['form']['providers'][$context['provider'] . '_settings'][$context['provider'] . '_models'] = [
            '#type' => 'markup',
            '#markup' => '<div class="description"><em>' . t('No models found on the configured Ollama server.') . '</em></div>',
            '#weight' => 100,
          ];
        }
      }
    }
    catch (Exception $e) {
      watchdog('openai_ollama', 'Failed to fetch Ollama models: @msg', ['@msg' => $e->getMessage()], WATCHDOG_WARNING);
      if (isset($context['form']['providers'])) {
        $context['form']['providers'][$context['provider'] . '_settings'][$context['provider'] . '_models'] = [
          '#type' => 'markup',
          '#markup' => '<div class="description"><em>' . t('Unable to fetch models from Ollama server.') . '</em></div>',
          '#weight' => 100,
        ];
      }
    }
   }

  // Add custom submit handler to save Ollama settings into central openai.settings
  if (isset($context['form'])) {
    $context['form']['#submit'][] = 'openai_ollama_settings_submit';
    // Do not attach a separate persist handler for enabled state; the main
    // openai settings submit handler manages enabled_providers centrally.
  }
}

/**
 * Custom submit handler to save Ollama-specific settings.
 */
function openai_ollama_settings_submit($form, &$form_state) {
  if (isset($form_state['values']['ollama_base_url'])) {
    // Persist into central openai.settings providers mapping so all provider
    // settings live in one place. Use the provider-specific key 'ollama_base_url'
    // and do NOT write the generic 'base_url' nor touch module config.
    $central = config('openai.settings');
    $providers = $central->get('providers') ?: [];
    if (!isset($providers['ollama']) || !is_array($providers['ollama'])) {
      $providers['ollama'] = [];
    }
    $providers['ollama']['ollama_base_url'] = $form_state['values']['ollama_base_url'];
    $central->set('providers', $providers);
    $central->save();

    backdrop_set_message(t('Ollama server URL has been saved to the OpenAI settings.'));
  }
}

/**
 * Ensure the Ollama enabled checkbox is persisted when the OpenAI settings
 * form is submitted, even if provider hooks didn't attach a submit handler.
 */
function openai_ollama_form_openai_settings_form_alter(&$form, &$form_state, $form_id) {
  if (!isset($form['#submit']) || !is_array($form['#submit'])) {
    $form['#submit'] = [];
  }
  // We do not attach a separate persist handler for enabled state because
  // the central OpenAI submit handler now records provider enabled flags.
}

/**
 * Fetch available Ollama models using the recommended /api/tags endpoint.
 *
 * @param string $base_url
 *   Base URL of the Ollama server (e.g. http://localhost:11434)
 *
 * @return array
 *   Indexed array of model items (each item is an array/object). Empty on failure.
 */
function openai_ollama_get_models($base_url) {
  $base_url = rtrim($base_url, " /");
  $endpoint = $base_url . '/api/tags';

  try {
    $resp = @backdrop_http_request($endpoint);
    if (empty($resp) || empty($resp->data)) {
      watchdog('openai_ollama', 'No response data from Ollama /api/tags @url', ['@url' => $endpoint], WATCHDOG_DEBUG);
      return [];
    }

    $data = json_decode($resp->data, TRUE);
    if (is_null($data)) {
      watchdog('openai_ollama', 'Failed to decode JSON from Ollama /api/tags @url', ['@url' => $endpoint], WATCHDOG_WARNING);
      return [];
    }

    // If the response contains a 'models' key, prefer that.
    if (isset($data['models']) && is_array($data['models'])) {
      return array_values($data['models']);
    }

    // Some Ollama setups return an array of model objects at top-level.
    if (is_array($data) && array_values($data) === $data) {
      // Ensure items look like model objects (have 'id') or are strings.
      $out = [];
      foreach ($data as $item) {
        if (is_string($item)) {
          $out[] = ['id' => $item];
        }
        elseif (is_array($item)) {
          $out[] = $item;
        }
      }
      return $out;
    }

    // Some responses may have nested shapes; try to find the first array we can use.
    foreach ($data as $k => $v) {
      if (is_array($v)) {
        // If it's a list, convert to indexed items.
        if (array_values($v) === $v) {
          $out = [];
          foreach ($v as $item) {
            if (is_string($item)) {
              $out[] = ['id' => $item];
            }
            elseif (is_array($item)) {
              $out[] = $item;
            }
          }
          if (!empty($out)) {
            return $out;
          }
        }
      }
    }

    return [];
  }
  catch (Exception $e) {
    watchdog('openai_ollama', 'Exception when contacting Ollama /api/tags: @msg', ['@msg' => $e->getMessage()], WATCHDOG_WARNING);
    return [];
  }
}
